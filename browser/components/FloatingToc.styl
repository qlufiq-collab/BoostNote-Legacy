.root
  width 220px
  height 100%
  flex-shrink 0
  display flex
  flex-direction column
  background-color $ui-noteDetail-backgroundColor
  border-left 1px solid alpha(#DEDEDE, 60%)
  overflow hidden

.header
  font-size 12px
  font-weight bold
  text-transform uppercase
  letter-spacing 0.5px
  padding 10px 12px
  border-bottom 1px solid alpha(#DEDEDE, 60%)
  color $ui-text-color
  flex-shrink 0

.body
  flex 1
  overflow-y auto
  padding 6px 0

.empty
  padding 12px
  font-size 12px
  color alpha($ui-text-color, 60%)
  font-style italic

.list
  list-style none
  margin 0
  padding 0

.item
  font-size 13px
  line-height 1.4
  margin 0
  padding 0
  a
    display block
    padding 4px 12px
    color $ui-text-color
    text-decoration none
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    cursor pointer
  a:hover
    background-color alpha(#1EC38B, 15%)
    color #1EC38B

.item.level-1 > a
  font-weight 600

.item.level-2 > a
  font-weight 500

body[data-theme="dark"]
  .root
    background-color $ui-dark-noteDetail-backgroundColor
    border-left 1px solid $ui-dark-borderColor
  .header
    color $ui-dark-text-color
    border-bottom 1px solid $ui-dark-borderColor
  .item a
    color $ui-dark-text-color

body[data-theme="solarized-dark"]
  .root
    background-color #073642
    border-left 1px solid #586E75
  .header
    color #93A1A1
    border-bottom 1px solid #586E75
  .item a
    color #93A1A1

apply-theme(theme)
  body[data-theme={theme}]
    .root
      background-color get-theme-var(theme, 'noteDetail-backgroundColor')
      border-left 1px solid get-theme-var(theme, 'borderColor')
    .header
      color get-theme-var(theme, 'text-color')
      border-bottom 1px solid get-theme-var(theme, 'borderColor')
    .item a
      color get-theme-var(theme, 'text-color')

for theme in 'dracula'
  apply-theme(theme)

for theme in $themes
  apply-theme(theme)
